TOCMEMEX_DB_PATH=data/tocmemex.db
TOCMEMEX_DATA_DIR=data

# MCP 工具面：default（14 个检索 / 入库 / 图书馆工具）| full（全部 47 个）
TOCMEMEX_TOOLS=default

# ── 入库队列 ────────────────────────────────────────────────────────────
# 同时解析的文档数。认领走 ingest_jobs 表的条件更新，所以这个上限对同时
# 连着一个库的 Web 与 MCP 进程都成立；多出的任务排队，前端「解析队列」可见。
TOCMEMEX_INGEST_CONCURRENCY=2
# MCP 的 ingest_path 只接受这些目录内的文件（库数据目录总是允许）。
# JSON 数组，例如 ["D:/work/papers"]。留空则只允许数据目录。
TOCMEMEX_INGEST_ROOTS=[]
# 单篇解析的最长墙钟时间（秒），在子进程内执行，父进程退出也不影响。
TOCMEMEX_INGEST_TIMEOUT_S=1800
# 认领后的任务超过这么久没有心跳，就视为子进程已死，启动时标记失败。
TOCMEMEX_INGEST_LEASE_S=90

# 网页/Inspector/MCP HTTP 的绑定策略。服务没有鉴权，默认只允许 127.0.0.1 /
# localhost / ::1；确需在局域网或反向代理后访问时设为 1。
TOCMEMEX_ALLOW_NONLOCAL=0

# ── OCR 后端 ────────────────────────────────────────────────────────────
# paddle（默认）| mistral | mineru | azure
# 只有 PDF 文本层不可用时才走 OCR；切换后端不影响已入库文档。
# 各厂商的字段见下方同名变量（PADDLEOCR_* / MISTRAL_* / MINERU_* / AZURE_DI_*）。
TOCMEMEX_OCR_PROVIDER=paddle
TOCMEMEX_OCR_POLL_TIMEOUT=600
TOCMEMEX_OCR_POLL_INTERVAL=5
# 自建/私有化 OCR（PaddleX、MinerU 局域网部署）时设为 1：
# 允许出站请求访问回环/内网地址并使用 http。默认 0——OCR 端点可在网页里
# 写入任意 base_url，不放开时服务器不会替你访问内网（SSRF 防护）。
TOCMEMEX_OCR_ALLOW_PRIVATE_HOSTS=0

# PaddleOCR-VL（默认，结构化 block 最完整）
PADDLEOCR_API_TOKEN=
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_API_MODEL=PaddleOCR-VL-1.6
# 可选：只覆盖 Paddle 的轮询参数；留空沿用上面的 TOCMEMEX_OCR_POLL_*。
PADDLEOCR_POLL_TIMEOUT=
PADDLEOCR_POLL_INTERVAL=

# Mistral OCR（同步接口，Markdown + 图片 bbox）
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1/ocr
MISTRAL_OCR_MODEL=mistral-ocr-latest

# MinerU（异步作业 + 结果 zip，可私有化）
MINERU_API_TOKEN=
MINERU_API_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=pipeline

# Azure AI Document Intelligence prebuilt-layout
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL=prebuilt-layout
AZURE_DI_API_VERSION=2024-11-30

TOCMEMEX_MAX_CHUNK_CHARS=1200
TOCMEMEX_CHUNK_OVERLAP=100

# 可选的检索同义词表（JSON），用于领域别名与跨语言查询侧词表。
# 默认不设置：通用检索不预设任何领域词。
# 领域别名例：       TOCMEMEX_SEARCH_SYNONYMS={"alpha":["beta","gamma"]}
# 跨语言查询侧词表例：TOCMEMEX_SEARCH_SYNONYMS={"氮化物":["nitride"],"外延":["epitaxial"]}
#   中文 query 会同时 OR 英文等价词，命中英文文档正文；词表只配中文→英文目标词，
#   不要给也会出现在中文目标 query 里的词配英文映射（会把英文整篇文档拉上来）。

# LLM 目录解析（可选）：三项任一留空只关闭 .env 回落；Web 设置页的默认端点仍可启用 LLM。
# 兼容 OpenAI chat/completions 协议的任意端点（DeepSeek / OpenAI / vLLM 等）。
TOCMEMEX_LLM_API_KEY=
TOCMEMEX_LLM_BASE_URL=
TOCMEMEX_LLM_MODEL=
TOCMEMEX_LLM_TEMPERATURE=0.0

# 请求参数默认值。Web 设置页里纲目/编修的配置（温度、max_tokens、重试、
# 超时、reasoning_effort）优先于这里；未配置 agent 时用这些值。
# 留空 REASONING_EFFORT 表示不发送该字段（使用服务端默认）。
TOCMEMEX_LLM_REASONING_EFFORT=
TOCMEMEX_LLM_MAX_TOKENS=4096
TOCMEMEX_LLM_RETRIES=1
TOCMEMEX_LLM_TIMEOUT=120

# LLM 调用日志（可选）：data/llm/calls.jsonl
#   full  每次调用存请求/返回前 800 字预览（默认）
#   meta  只存长度与工具名，不存正文
#   off   不写日志
# full 会把最多 800 字文档正文落到磁盘；文件按 0600、目录按 0700 创建。
# 不想让正文落盘就设 meta。
TOCMEMEX_LLM_LOG=full
